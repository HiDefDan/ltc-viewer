[Unit]
Description=LTC Timecode Reader for Raspberry Pi 5

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/ltc-timecode
Restart=on-failure
RestartSec=10
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ltc-timecode
Environment=LTC_RTA_PERIOD_FRAMES=32
Environment=LTC_SMOOTH_ENABLE=0
Environment=LTC_RTA_NUM_BUFFERS=2
Environment=LTC_RTA_RT_PRIORITY=85
Environment=LTC_PHASE_ADVANCE_FRAMES=1
Environment=LTC_LIVE_NEED_RENDER_DIV=20
Environment=LTC_LIVE_IDLE_DIV=16
Environment=LTC_LIVE_SLEEP_MIN_US=100
Environment=LTC_LIVE_SLEEP_MAX_US=2000

# Isolate the service to the dedicated render core.
CPUAffinity=3

# Real-time scheduling — uncomment to enable SCHED_FIFO from systemd
# (alternative to the application setting it via sched_setscheduler)
#CPUSchedulingPolicy=fifo
#CPUSchedulingPriority=50

[Install]
WantedBy=multi-user.target
