[Unit]
Description=LTC Timecode Reader for Raspberry Pi 5

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/ltc-timecode
Restart=on-failure
RestartSec=10
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ltc-timecode

# Isolate the service to the dedicated render core.
CPUAffinity=3

# Real-time scheduling — uncomment to enable SCHED_FIFO from systemd
# (alternative to the application setting it via sched_setscheduler)
#CPUSchedulingPolicy=fifo
#CPUSchedulingPriority=50

[Install]
WantedBy=multi-user.target
